APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# FunLink Poster module (app/Poster) — Drive intake
# The "FunLink Posts" folder in Google Drive.
DRIVE_POSTS_FOLDER_ID=
# Phase 1 Drive client binary (hatch_gws_cli); authenticated on the Lotus VM only,
# so poster:intake fails loudly anywhere else until the native client lands.
DRIVE_CLI_BIN=/opt/hatch/bin/hatch_gws_cli
# Public base URL where normalized assets are hosted (Instagram/Threads/TikTok fetch media by URL).
POSTER_ASSET_BASE_URL=
# Poster platform credentials (app-level; per-account tokens are stored encrypted on poster_platform_accounts)
FACEBOOK_PAGE_ID=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
THREADS_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

# FunLink Poster Phase 2 — real publishing adapters + OAuth connect flow.
# App secrets are read from the environment ONLY (set them in Laravel Cloud);
# never commit real values. App id / client key / page id are public
# identifiers, so their defaults live in config/poster.php.
POSTER_META_APP_ID=1420149999776735
POSTER_META_APP_SECRET=
POSTER_META_PAGE_ID=61563258179586
POSTER_META_GRAPH_VERSION=v21.0
POSTER_META_REDIRECT_URI="https://funlynk.com/poster/connect/meta/callback"
POSTER_TIKTOK_CLIENT_KEY=aw1a16e8hrl8w5a7
POSTER_TIKTOK_CLIENT_SECRET=
POSTER_TIKTOK_REDIRECT_URI="https://funlynk.com/poster/connect/tiktok/callback"
# Comma-separated email allowlist for the /poster/connect/* admin routes.
# Defaults to the same addresses as the Horizon gate when unset.
POSTER_ADMIN_EMAILS=
