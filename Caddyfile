# FunLynk Caddy Configuration

funlynk.com, www.funlynk.com {
    reverse_proxy app:8000
}

# The reverse proxy for WebSocket connections to Laravel Reverb
ws.178.156.193.56.nip.io {
    reverse_proxy reverb:8080
}

# Fallback for IP access (useful for testing)
http://178.156.193.56 {
    reverse_proxy app:8000
}

